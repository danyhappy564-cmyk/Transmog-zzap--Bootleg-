<Project Sdk="Microsoft.NET.Sdk">

  <!-- 개인 경로는 LocalSettings.props 에 (LocalSettings.props.example 복사). 없으면 SPT_ROOT 환경변수 > 기본값 -->
  <Import Project="$(MSBuildThisFileDirectory)LocalSettings.props"
          Condition="Exists('$(MSBuildThisFileDirectory)LocalSettings.props')" />

  <PropertyGroup>
    <SptRoot Condition="'$(SptRoot)' == '' And '$(SPT_ROOT)' != ''">$(SPT_ROOT)</SptRoot>
    <SptRoot Condition="'$(SptRoot)' == ''">E:\SPT 4.1</SptRoot>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net472</TargetFramework>
    <AssemblyName>Transmog</AssemblyName>
    <RootNamespace>Transmog</RootNamespace>
    <Version>1.3.1.1</Version>
    <LangVersion>latest</LangVersion>
    <Deterministic>true</Deterministic>
    <AppendTargetFrameworkToOutputPath>false</AppendTargetFrameworkToOutputPath>
    <OutputPath>bin\$(Configuration)\</OutputPath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <ImplicitUsings>disable</ImplicitUsings>
    <NoWarn>$(NoWarn);CS0108;CS0114;CS8632</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="src\**\*.cs" />
  </ItemGroup>

  <PropertyGroup>
    <Managed>$(SptRoot)\EscapeFromTarkov_Data\Managed\</Managed>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Assembly-CSharp"><HintPath>$(Managed)Assembly-CSharp.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Comfort"><HintPath>$(Managed)Comfort.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine"><HintPath>$(Managed)UnityEngine.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.CoreModule"><HintPath>$(Managed)UnityEngine.CoreModule.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="Sirenix.Serialization"><HintPath>$(Managed)Sirenix.Serialization.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="UnityEngine.UI"><HintPath>$(Managed)UnityEngine.UI.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="BepInEx"><HintPath>$(SptRoot)\BepInEx\core\BepInEx.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="0Harmony"><HintPath>$(SptRoot)\BepInEx\core\0Harmony.dll</HintPath><Private>false</Private></Reference>
    <Reference Include="spt-reflection"><HintPath>$(SptRoot)\BepInEx\plugins\spt\spt-reflection.dll</HintPath><Private>false</Private></Reference>
  </ItemGroup>

  <!-- 빌드 후: 게임 폴더에 복사(있을 때만) + 배포용 zip -->
  <Target Name="DeployAndPackage" AfterTargets="Build">
    <PropertyGroup>
      <PkgDir>$(MSBuildProjectDirectory)\release\_pkg\</PkgDir>
      <PkgZip>$(MSBuildProjectDirectory)\release\Transmog-$(Version).zip</PkgZip>
    </PropertyGroup>
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(SptRoot)\BepInEx\plugins\Transmog\"
          Condition="Exists('$(SptRoot)\BepInEx\plugins')" />
    <RemoveDir Directories="$(PkgDir)" />
    <MakeDir Directories="$(PkgDir)BepInEx\plugins\Transmog" />
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(PkgDir)BepInEx\plugins\Transmog\" />
    <Delete Files="$(PkgZip)" />
    <ZipDirectory SourceDirectory="$(PkgDir)" DestinationFile="$(PkgZip)" />
    <RemoveDir Directories="$(PkgDir)" />
  </Target>

</Project>
